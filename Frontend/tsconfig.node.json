{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",  // 🔹 Wichtig für `import.meta.env`
    "moduleResolution": "NodeNext", // 🔹 Verbessert Modulauflösung für Node.js
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,  // 🔹 Erlaubt JSON- und CommonJS-Imports
    "allowSyntheticDefaultImports": true, // 🔹 Erlaubt Import von JSON-Dateien

    /* Bundler mode (deaktiviert) */
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.config.ts", "src/**/*", "src/abis/**/*.json"]
}
